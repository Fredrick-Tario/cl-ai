# CL-AI model provider: qwen, nvidia_nim, or openai_compatible
AI_PROVIDER=qwen
AI_PROVIDER_NAME=

# Generic OpenAI-compatible settings (recommended for NVIDIA NIM/custom APIs)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Backward-compatible Qwen settings, used when generic values are empty
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Guardrail for interactive sessions
CLAI_MAX_AI_REQUESTS_PER_SESSION=30

# Request timeout in seconds
QWEN_TIMEOUT_SECONDS=30

# Free official-documentation retrieval timeout; no search API key is required
WEB_TIMEOUT_SECONDS=15

# Local CL-AI data (database and future artifacts)
CLAI_DATA_DIR=~/.cl-ai

